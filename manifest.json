{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "Aegis — Privacy-Preserving Browser Agent",
  "version": "0.1.0",
  "description": "On-device visual perception for lightweight browser agents. Intercepts screen content, redacts sensitive elements locally, and sends only sanitized data to a cloud VLM.",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "offscreen",
    "contextMenus"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/field-mapper.js",
        "src/content/autofill.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },

  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },

  "commands": {
    "autofill_page": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Autofill active web page form with Aegis profile"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["src/offscreen/offscreen.html", "src/voice/voice.html", "src/dashboard/dashboard.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
